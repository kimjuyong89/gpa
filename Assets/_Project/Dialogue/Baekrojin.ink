INCLUDE _externals.ink
INCLUDE Baekrojin_Sects.ink
INCLUDE Baekrojin_Ledger.ink
INCLUDE Baekrojin_Companions.ink
INCLUDE Baekrojin_Mountain.ink

// 백로진(白鷺鎭) — M1 시작 마을. 샘플 대본.

=== 객잔_점소이 ===
점소이: 어서 옵쇼, 손님! 백로진 제일 객잔입니다요.
+ {money() >= 20} [하룻밤 묵겠소. (20냥)]
    ~ pay(20)
    ~ rest_inn()
    점소이: 편히 쉬십쇼! 내일 아침엔 국밥이 일품입니다요.
    -> END
+ {quest_stage("대사형의 장부") == 0} [요즘 마을에 별일 없소?]
    -> 소문
+ [됐소.]
    점소이: 또 오십쇼!
    -> END

= 소문
점소이: 별일이야… 쉿, 큰 소리론 못 합니다만.
점소이: 밤마다 나루터 창고에 흑사방 놈들이 뭘 잔뜩 옮긴답니다.
점소이: 근데 그 자리에 청운검문 대사형 나리가 있었다는 소문이…
* [청운검문 사람이 왜 거기 있겠소?]
    점소이: 그러게 말입니다요. 소인은 아무 말도 안 했습니다요!
* [흑사방이 무섭지도 않소?]
    점소이: 무섭죠! 그래서 이렇게 손님한테만 속삭이는 거 아닙니까.
- 점소이: 아무튼 조심하십쇼, 손님.
~ add("호감.점소이", 1)
~ quest("대사형의 장부", 1, "객잔 점소이가, 흑사방 창고에서 청운검문 대사형을 봤다는 소문을 들려주었다.")
-> END

=== 장터_상인 ===
장터 상인: 어서 오시오. 약이며 병장기며, 백로진에서 구할 수 있는 건 다 있소.
+ [물건을 본다.]
    장터 상인: 천천히 보시구려. # shop: 백로진
    장터 상인: 또 오시오.
    -> END
+ [됐소.]
    -> END

=== 나루터_흑사방 ===
흑사방 졸개: 어이, 거기! 여긴 흑사방 구역이다. 썩 꺼져.
+ [물러서지 않는다.]
    주인공: 이 나루터는 백로진 사람 모두의 것이오.
    ~ add("정파", 1)
    ~ add("평판.흑사방", -1)
    흑사방 졸개: 이 자식이! 얘들아! # battle: 흑사방_졸개들
    {get("전투.흑사방_졸개들") > 0:
        흑사방 졸개: 크윽… 두고 보자! 방주님이 가만있지 않을 거다!
        ~ add("평판.백로진", 1)
    - else:
        (쓰러진 사이 흑사방 졸개들이 전낭을 털어 갔다.)
        ~ pay(money())
    }
    -> END
+ {money() >= 10} [엽전 몇 닢을 쥐여 준다. (10냥)]
    ~ pay(10)
    ~ add("사파", 1)
    ~ add("평판.흑사방", 1)
    흑사방 졸개: 흐흐, 말이 통하는 친구구먼. 지나가.
    {quest_stage("대사형의 장부") == 1:
        흑사방 졸개: …창고 쪽은 기웃거리지 마라. 대사형 나리 손님이 오시는 날이거든.
        ~ quest("대사형의 장부", 2, "흑사방 졸개가 창고에 '대사형 나리 손님'이 온다고 흘렸다.")
    }
    -> END
+ [조용히 돌아선다.]
    -> END

// M1 동료: 하오문 소매치기 소육과의 만남
=== 뒷골목_소육 ===
{get("동료.소육") > 0: -> 동행}
{get("호감.소육") >= 3: -> 재회}
(누군가 허리춤을 스치고 지나간다. 전낭이 가볍다.)
+ [소매치기를 붙잡는다.]
    소육: 아얏! 놔, 놓으라고! …쳇, 눈치는 빠르네.
    소육: 돈은 돌려줄게. 대신 밥 한 끼만 사 주면 안 돼? 이틀 굶었거든.
    ++ {money() >= 5} [국밥 한 그릇 사 준다. (5냥)]
        ~ pay(5)
        ~ add("호감.소육", 3)
        소육: …너 이상한 놈이다. 좋아, 이 동네 일이라면 내가 다 알아. 데려가.
        ~ temp joined = recruit("소육")
        {joined:
            (소육이 동료가 되었다.)
        - else:
            소육: …근데 일행이 꽉 찼네. 자리 나면 불러.
        }
    ++ [혼쭐만 내고 보낸다.]
        ~ add("호감.소육", -1)
        소육: 흥, 다음엔 안 걸린다!
    -- -> END
+ [모른 척한다.]
    (뒷골목은 금세 조용해졌다. 몇 냥이 사라졌다.)
    ~ pay(5)
    -> END

= 재회
소육: 왜, 이제 자리가 났어?
+ {not party_full()} [함께 가자.]
    ~ recruit("소육")
    소육: 그럴 줄 알았지.
    (소육이 동료가 되었다.)
    -> END
+ [아직이다.]
    소육: 쳇.
    -> END

= 동행
소육: 왜? 또 무슨 일 있어?
+ {quest_stage("대사형의 장부") >= 1} [창고 소문에 대해 아는 거 있어?]
    소육: 하오문 귀는 어디에나 있지. 그 대사형이란 작자, 달 없는 밤마다 창고 뒷문으로 들어가.
    ~ add("호감.소육", 1)
    -> END
+ [아무것도 아니야.]
    소육: 싱겁긴.
    -> END

// 경공으로 강을 뛰어넘어야 닿는 섬의 기연
=== 강변_은둔노인 ===
{get("기연.은둔노인") > 0:
    은둔 노인: 허허, 또 건너왔는가. 젊음이 좋긴 좋구먼.
    -> END
}
은둔 노인: 허허, 이 섬에 발을 디딘 이는 십 년 만이군.
은둔 노인: 경공이 제법이나 아직 발끝에 힘이 들어가 있어. 잠시 앉아 보게.
(노인의 손끝이 등을 짚자 따뜻한 기운이 단전으로 모인다.)
~ set("기연.은둔노인", 1)
~ inner_power(30)
~ give("운리화", 1)
~ give("비연단", 1)
은둔 노인: 이 신과 단약도 가져가게. 나는 이제 뛸 일이 없으니.
(운리화와 비연단을 받았다.)
은둔 노인: 강호는 넓다네. 갚을 생각 말고 오래 살아남게나.
-> END
